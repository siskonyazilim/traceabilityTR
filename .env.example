SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@example.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=Traceability Website <your-mailbox@example.com>
SMTP_TO=contact-recipient@example.com
SITE_NAME=Traceability

# Optional: Cloudflare Turnstile (leave empty to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_CEREZGO_SRC=https://cdn.cerezgo.com/file/cerezgo.min.js
NEXT_PUBLIC_CEREZGO_KEY=replace-with-cerezgo-public-key
NEXT_PUBLIC_CEREZGO_ID=nt
NEXT_PUBLIC_COOKIE_PROVIDER=auto